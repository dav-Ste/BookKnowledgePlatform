{
  "ReverseProxy": {
    "Routes": {
      "books": { "ClusterId": "books", "Match": { "Path": "/api/books/{**catch-all}" } },
      "content": { "ClusterId": "content", "Match": { "Path": "/api/content/{**catch-all}" } },
      "identity": { "ClusterId": "identity", "Match": { "Path": "/api/identity/{**catch-all}" } }
    },
    "Clusters": {
      "books": { "Destinations": { "destination1": { "Address": "https://books" } } },
      "content": { "Destinations": { "destination1": { "Address": "https://content-search" } } },
      "identity": { "Destinations": { "destination1": { "Address": "https://identity" } } }
    }
  }
}
